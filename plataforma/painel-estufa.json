                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "ag47gg2pnery8b"
                      },
                      "spec": {
                        "dataset": "fei",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "\r\nSELECT\r\n    measure_time AS time,\r\n    MAX(CASE\r\n        WHEN attrName = 'temperature'\r\n        THEN CAST(attrValue AS DECIMAL(10,2))\r\n    END) AS Temperatura,\r\n    MAX(CASE\r\n        WHEN attrName = 'relativeHumidity'\r\n        THEN CAST(attrValue AS DECIMAL(10,2))\r\n    END) AS Umidade\r\nFROM (\r\n    SELECT\r\n        FROM_UNIXTIME(CAST(recvTimeTs AS UNSIGNED) / 1000) AS measure_time,\r\n        attrName,\r\n        attrValue\r\n    FROM fei.estufa\r\n    WHERE entityId = 'urn:ngsi-ld:Greenhouse:001'\r\n      AND attrName IN ('temperature', 'relativeHumidity')\r\n) AS medicoes\r\nWHERE $__timeFilter(measure_time)\r\nGROUP BY measure_time\r\nORDER BY time ASC;\r\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "B",
                    "hidden": false
